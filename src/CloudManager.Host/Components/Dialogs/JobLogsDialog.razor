<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-all;">@ErrorDetail</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCloseClick">閉じる</MudButton>
    </DialogActions>
</MudDialog>
